# Copy to .env and fill in. NEVER commit .env or share these keys.
# Get keys at https://app.alpaca.markets (paper keys are separate from live keys).

ALPACA_KEY_ID=your-paper-key-id
ALPACA_SECRET_KEY=your-paper-secret

# Trading endpoint. Paper by default — change to https://api.alpaca.markets
# ONLY when you have verified the strategy and accept real losses.
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Comma-separated symbols to trade
SYMBOLS=SPY,AAPL,MSFT

# Strategy parameters
FAST_SMA=9
SLOW_SMA=21
TAKE_PROFIT_PCT=1.5
STOP_LOSS_PCT=1.0

# Risk limits
MAX_POSITION_USD=1000
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_USD=100

# Poll interval in seconds
POLL_SECONDS=60
